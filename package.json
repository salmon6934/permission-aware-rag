{
  "name": "permission-aware-rag",
  "version": "0.1.0",
  "description": "Permission-Aware Multi-Tenant RAG System with in-query vector authorization and tamper-evident audit logging",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:embedder": "tsx scripts/test-embedder.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^16.4.7",
    "fast-json-stable-stringify": "^2.1.0",
    "fastify": "^5.2.1",
    "jose": "^6.0.8",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.3",
    "pgvector": "^0.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/fast-json-stable-stringify": "^2.0.0",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
